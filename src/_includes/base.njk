<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ page.url | absUrl }}">
{% if not site.indexable or noindex %}<meta name="robots" content="noindex">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
<meta name="theme-color" content="#1f272a">
<meta property="og:image" content="{{ '/assets/brand/og.png' | absUrl }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/brand/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
{% include "schema.njk" %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">Skip to content</a>
<header class="masthead">
  <div class="masthead__row wrap">
    <a class="logo" href="/"><picture><source media="(max-width:560px)" srcset="/assets/brand/mark.png" width="56" height="40"><img src="/assets/brand/logo-lockup.png" alt="Vertic Tree Works" width="212" height="46"></picture></a>
    <nav class="nav" aria-label="Main">
      <a href="/services/"{% if page.url == "/services/" %} aria-current="page"{% endif %}>Services</a>
      <a href="/emergency-storm/"{% if page.url == "/emergency-storm/" %} aria-current="page"{% endif %}>Storm &amp; emergency</a>
      <a href="/areas/"{% if "/areas/" in page.url %} aria-current="page"{% endif %}>Areas</a>
      <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
      <a href="/faq/"{% if page.url == "/faq/" %} aria-current="page"{% endif %}>FAQ</a>
    </nav>
    <div class="masthead__actions">
      <a class="btn btn--call" href="{{ site.phone | tel }}" aria-label="Call {{ site.phone }}">Call<span class="hide-sm">&nbsp;{{ site.phone }}</span></a>
      <a class="btn btn--go" href="/contact/">Free Estimate</a>
    </div>
    <details class="menu">
      <summary aria-label="Menu">Menu</summary>
      <div class="menu__panel">
        <a href="/services/">All services</a>
        {% for s in services %}{% if not s.optional or site.landClearingLive %}<a href="/{{ s.slug }}/">{{ s.name }}</a>{% endif %}{% endfor %}
        <a href="/areas/">Service areas</a>
        <a href="/about/">About</a>
        <a href="/insurance-trust/">Insurance</a>
        <a href="/gallery/">Gallery</a>
        <a href="/faq/">FAQ</a>
        <a href="/contact/">Contact</a>
      </div>
    </details>
  </div>
  <p class="trustbar">{{ license.chip }} · Free estimates</p>
</header>

<main id="main">
{% if crumbs %}
<nav class="crumbs wrap" aria-label="Breadcrumb"><a href="/">Home</a>{% for c in crumbs %} / {% if c[1] %}<a href="{{ c[1] }}">{{ c[0] }}</a>{% else %}<span aria-current="page">{{ c[0] }}</span>{% endif %}{% endfor %}</nav>
{% endif %}
{{ content | safe }}
</main>

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <img class="footer__logo" src="/assets/brand/logo-stacked.png" alt="Vertic Tree Works" width="150" height="124" loading="lazy">
      <p><a class="footer__phone" href="{{ site.phone | tel }}">{{ site.phone }}</a><br>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
      {{ answers.hours }}</p>
      <p class="footer__trust">{{ license.chip }}</p>
    </div>
    <div>
      <h2>Services</h2>
      <ul>{% for s in services %}{% if not s.optional or site.landClearingLive %}<li><a href="/{{ s.slug }}/">{{ s.name }}</a></li>{% endif %}{% endfor %}</ul>
    </div>
    <div>
      <h2>Areas</h2>
      <ul>{% for a in areas %}<li><a href="/areas/{{ a.slug }}/">{{ a.city }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/insurance-trust/">Insurance &amp; safety</a></li>
        <li><a href="/gallery/">Gallery</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Free estimate</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
  </div>
  <p class="wrap footer__legal">© {{ site.year }} {{ site.legalName }} · Serving {{ site.parishes }}</p>
</footer>
</body>
</html>
