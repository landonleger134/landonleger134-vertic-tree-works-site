---
layout: base.njk
permalink: /contact/
title: "Free Tree Service Estimate | Baton Rouge | Vertic Tree Works"
description: "Tell us about your tree job in Baton Rouge or nearby. Call (225) 418-2720 or send photos for a fast estimate."
crumbs: [["Free estimate"]]
bodyClass: contact
---
<section class="pagehead">
  <div class="wrap">
    <h1>Get a free tree work estimate</h1>
    <p class="lede">Tell us what you need. Use the form for planned removals, trims, and stumps — photos speed things up.</p>
    <p class="urgent"><strong>Storm or hazard?</strong> Don’t use the form. <a href="{{ site.phone | tel }}">Call {{ site.phone }} now</a>.</p>
  </div>
</section>
<section class="section">
  <div class="wrap contact-grid">
    <form class="estimate" name="estimate" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company_website" enctype="multipart/form-data">
      <input type="hidden" name="form-name" value="estimate">
      <p class="hp"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off"></label></p>
      <div class="field"><label for="f-name">Full name</label><input id="f-name" name="name" autocomplete="name" required></div>
      <div class="field-row">
        <div class="field"><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" required pattern="^\D*(\d\D*){10,}$" title="Include your full 10-digit phone number"></div>
        <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required></div>
      </div>
      <div class="field-row">
        <div class="field"><label for="f-city">City or area</label>
          <select id="f-city" name="city" required>
            <option value="">Choose one</option>
            {% for a in areas %}<option>{{ a.city }}</option>{% endfor %}
            <option>Other (tell us below)</option>
          </select></div>
        <div class="field"><label for="f-service">Service</label>
          <select id="f-service" name="service" required>
            <option value="">Choose one</option>
            <option>Tree removal</option><option>Tree trimming</option><option>Stump grinding</option>
            <option>Storm / emergency</option><option>Land clearing</option><option>Not sure</option><option>Other</option>
          </select></div>
      </div>
      <div class="field"><label for="f-desc">What’s going on with the tree?</label>
        <textarea id="f-desc" name="description" rows="5" required placeholder="Type of tree if you know it, how close it is to the house, fences or lines nearby…"></textarea></div>
      <div class="field"><label for="f-photo">Photo (optional, but it helps)</label><input id="f-photo" name="photo" type="file" accept="image/*"><small class="opt">One image, up to 8 MB.</small></div>
      <div class="field-row">
        <div class="field"><label for="f-time">Best time to reach you <span class="opt">(optional)</span></label><input id="f-time" name="contact_time"></div>
        <div class="field"><label for="f-heard">How did you hear about us? <span class="opt">(optional)</span></label><input id="f-heard" name="heard_about"></div>
      </div>
      <div class="field field--check"><input id="f-consent" name="consent" type="checkbox" value="yes" required><label for="f-consent">You can contact me about this estimate.</label></div>
      <button class="btn btn--go btn--xl" type="submit">Request Free Estimate</button>
      <p class="form-error" role="alert" hidden>Something didn’t send. Call or text <a href="{{ site.phone | tel }}">{{ site.phone }}</a> and we’ll take it from here.</p>
    </form>
    <aside class="contact-aside">
      <h2>Prefer to talk?</h2>
      <p><a class="bigphone" href="{{ site.phone | tel }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p>{{ answers.hours }}</p>
      <p class="small">{{ license.chip }}</p>
    </aside>
  </div>
</section>
<script>
// Sends the request to the ops app (Vertic leads) and to Netlify Forms as a
// backup copy. Succeeds if either lands; only shows the error if both fail.
// Without JS the form still posts normally to Netlify and /thanks/.
(function () {
  var ENDPOINT = {{ site.leadEndpoint | json | safe }};
  var MAX = 8 * 1024 * 1024;
  var form = document.querySelector("form.estimate");
  var err = form.querySelector(".form-error");
  var photo = form.querySelector("#f-photo");
  photo.addEventListener("change", function () {
    var f = photo.files[0];
    photo.setCustomValidity(f && f.size > MAX ? "That photo is over 8 MB — try a smaller one, or send it by text." : "");
  });
  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!form.reportValidity()) return;
    err.hidden = true;
    var btn = form.querySelector("button[type=submit]");
    btn.disabled = true; btn.textContent = "Sending…";
    var data = new FormData(form);
    var ok = function (r) { if (!r.ok) throw new Error(r.status); return true; };
    Promise.allSettled([
      fetch(ENDPOINT, { method: "POST", body: data }).then(ok),
      fetch("/", { method: "POST", body: data }).then(ok)
    ]).then(function (results) {
      if (results.some(function (r) { return r.status === "fulfilled"; })) {
        window.location.href = "/thanks/";
      } else {
        err.hidden = false; btn.disabled = false; btn.textContent = "Request Free Estimate";
      }
    });
  });
})();
</script>
