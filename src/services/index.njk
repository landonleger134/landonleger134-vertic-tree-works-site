        <a href="/{{ s.slug }}/"><h2>{{ s.name }}</h2><p>{{ s.card }}</p><p class="small">{{ s.intro[0] }}</p><span class="more">{% if s.emergency %}Call first{% else %}Learn more{% endif %}</span></a>
      </li>
      {% endif %}{% endfor %}
